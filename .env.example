# 모든 Agent가 공유할 때 사용하는 32자 이상 ASCII 토큰입니다.
# 기본값은 없으며 AGENT_API_TOKENS_JSON과 동시에 설정할 수 없습니다.
AGENT_API_TOKEN=

# Agent별 토큰이 필요하면 JSON 객체로 설정합니다. 이 모드에서는 요청의
# X-Agent-ID가 payload의 agent_id와 일치해야 합니다.
# 예: {"agent-01":"32자 이상의 서로 다른 임의 토큰"}
AGENT_API_TOKENS_JSON=

# 비워두면 Web의 /api/v1/analyze 중계 API가 503을 반환합니다.
# Host Agent가 AI Server를 직접 호출하는 기본 경로에는 영향을 주지 않습니다.
# 예: http://127.0.0.1:9000 또는 http://127.0.0.1:9000/api/v1/analyze
AI_SERVER_URL=

# 외부 AI 서버 사용 시 AI_API_TOKEN과 같은 32자 이상 ASCII 값을 설정합니다.
AI_SERVER_TOKEN=

# 외부 AI 서버 응답 대기 시간(초)입니다.
AI_SERVER_TIMEOUT_SECONDS=5

# Web 대시보드에서 고위험 이벤트로 표시할 AI 점수 임계값입니다(0.0~1.0).
HIGH_RISK_SCORE_THRESHOLD=0.85

# loopback 개발에서만 네 값을 모두 비울 수 있습니다. LAN 바인딩은 필수입니다.
# 서로 다른 ASCII 사용자명과 16자 이상 ASCII 비밀번호를 모두 설정하세요.
# Basic 인증은 HTTPS 요청에서만 허용됩니다. 직접 TLS를 쓰거나 Web 앱을 loopback에
# 바인딩하고 HTTPS reverse proxy만 LAN에 공개하세요.
DASHBOARD_VIEWER_USERNAME=
DASHBOARD_VIEWER_PASSWORD=
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=
