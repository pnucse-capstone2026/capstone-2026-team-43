# Host Agent가 /api/v1/analyze 및 /api/v1/logs 호출 시 사용하는 토큰입니다.
# 팀 공유 또는 시연 환경에서는 반드시 32자 이상 ASCII 임의 값으로 교체하세요.
AGENT_API_TOKEN=

# 비워두면 웹 서버 내부 Mock 분석기를 사용합니다.
# 예: http://127.0.0.1:9000 또는 http://127.0.0.1:9000/api/v1/analyze
AI_SERVER_URL=

# 외부 AI 서버 사용 시 AI_API_TOKEN과 같은 32자 이상 ASCII 값을 설정합니다.
AI_SERVER_TOKEN=

# 외부 AI 서버 응답 대기 시간(초)입니다.
AI_SERVER_TIMEOUT_SECONDS=5

# Web 대시보드에서 고위험 이벤트로 표시할 AI 점수 임계값입니다(0.0~1.0).
HIGH_RISK_SCORE_THRESHOLD=0.85

# 네 값을 모두 비우면 대시보드 HTTP Basic 인증이 비활성화됩니다.
# 활성화하려면 서로 다른 ASCII 사용자명과 16자 이상 ASCII 비밀번호를 모두 설정하세요.
# 통제된 LAN 밖에서는 반드시 HTTPS reverse proxy 뒤에서만 사용하세요.
DASHBOARD_VIEWER_USERNAME=
DASHBOARD_VIEWER_PASSWORD=
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=
